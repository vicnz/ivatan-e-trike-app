{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@db-types": [
        "./database.types.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "./global.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "./database.types.ts"
  ]
}